-- ============ FEATURE: ESP (WALLHACK) ================
-- =====================================================
local espEnabled = false
local espObjects = {}
local espConnections = {}

local function createESP(playerObj)
    if playerObj == player then return end
    local char = playerObj.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    if not root or not head then return end
    
    local box = Drawing.new("Box")
    box.Thickness = 2
    box.Transparency = 0.7
    box.Filled = false
    box.Color = Color3.fromRGB(255, 0, 0)
    
    local nameTag = Drawing.new("Text")
    nameTag.Size = 14
    nameTag.Center = true
    nameTag.Outline = true
    nameTag.OutlineColor = Color3.new(0, 0, 0)
    nameTag.Color = Color3.fromRGB(255, 255, 255)
    nameTag.Text = playerObj.Name
    
    local healthTag = Drawing.new("Text")
    healthTag.Size = 12
    healthTag.Center = true
    healthTag.Outline = true
    healthTag.OutlineColor = Color3.new(0, 0, 0)
    
    espObjects[playerObj] = {box = box, nameTag = nameTag, healthTag = healthTag, root = root, head = head, char = char}
end

local function updateESP()
    for playerObj, data in pairs(espObjects) do
        if not playerObj or not playerObj.Character then
            data.box.Visible = false
            data.nameTag.Visible = false
            data.healthTag.Visible = false
            continue
        end
        
        local rootPos = data.root.Position
        local headPos = data.head.Position
        local rootScreen, headScreen = camera:WorldToViewportPoint(rootPos), camera:WorldToViewportPoint(headPos)
        
        if rootScreen.Z <= 0 or headScreen.Z <= 0 then
            data.box.Visible = false
            data.nameTag.Visible = false
            data.healthTag.Visible = false
            continue
        end
        
        local height = math.abs(rootScreen.Y - headScreen.Y) * 1.8
        local width = height * 0.5
        local x = rootScreen.X - width / 2
        local y = headScreen.Y - height * 0.3
        
        data.box.Visible = true
        data.box.Size = Vector2.new(width, height)
        data.box.Position = Vector2.new(x, y)
        
        data.nameTag.Visible = true
        data.nameTag.Position = Vector2.new(rootScreen.X, headScreen.Y - height * 0.4)
        
        local health = data.char:FindFirstChild("Humanoid") and data.char.Humanoid.Health or 100
        data.healthTag.Visible = true
        data.healthTag.Text = math.round(health) .. "%"
        data.healthTag.Color = health > 50 and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
        data.healthTag.Position = Vector2.new(rootScreen.X, headScreen.Y + height * 0.1)
    end
end

local function clearESP()
    for _, data in pairs(espObjects) do
        data.box:Remove()
        data.nameTag:Remove()
        data.healthTag:Remove()
    end
    espObjects = {}
    for _, conn in pairs(espConnections) do
        conn:Disconnect()
    end
    espConnections = {}
end

local function toggleESP()
    espEnabled = not espEnabled
    if espEnabled then
        espButton.Text = "✅ WALLHACK"
        espButton.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
        for _, p in pairs(player:GetPlayers()) do
            createESP(p)
        end
        espConnections[#espConnections+1] = player.PlayerAdded:Connect(createESP)
        espConnections[#espConnections+1] = player.PlayerRemoving:Connect(function(p) 
            if espObjects[p] then
                espObjects[p].box:Remove()
                espObjects[p].nameTag:Remove()
                espObjects[p].healthTag:Remove()
                espObjects[p] = nil
            end
        end)
        espConnections[#espConnections+1] = runService.RenderStepped:Connect(function()
            if espEnabled then updateESP() end
        end)
    else
        espButton.Text = "brickheck WALLHACK"
        espButton.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        clearESP()
    end
end

espButton.MouseButton1Click:Connect(toggleESP)

